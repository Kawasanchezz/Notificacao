# Copy to .env and replace every value. .env is git-ignored.
# Use letters and digits only in passwords (they are embedded in the MongoDB URI).

POSTGRES_USER=taskscheduler
POSTGRES_PASSWORD=replace-with-a-long-random-password
MONGO_USER=taskscheduler
MONGO_PASSWORD=replace-with-another-long-random-password

# At least 32 random bytes, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
